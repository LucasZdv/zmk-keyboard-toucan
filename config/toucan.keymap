#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define ADJ  3

/ {
    macros {
        php_this: php_this {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DLLR &kp T &kp H &kp I &kp S &kp MINUS &kp GT>;
        };

        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };

        fat_arrow: fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB        &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
                &mt LSHFT CLCK &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LCTRL      &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                        &kp LALT  &kp LGUI  &lt 1 SPACE  &lt 2 RET  &kp RGUI  &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH   &kp DLLR    &kp LPAR      &kp RPAR  &kp HOME  &kp UP    &kp END    &kp PG_UP  &kp DEL
                &trans     &none     &none   &php_this  &arrow      &kp LBRC      &kp RBRC  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN  &kp BSLH
                &trans     &none     &none   &none      &fat_arrow  &kp LBKT      &kp RBKT  &kp TILDE &kp LT    &kp GT     &kp MINUS  &kp EQUAL
                                              &trans     &trans      &trans        &tog 2    &trans    &trans
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT     &kp LPAR  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY  &kp BSPC
                &none      &kp CARET  &kp AMPS  &none     &none     &none         &kp RPAR  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS     &kp KP_DIVIDE
                &none      &none      &none     &none     &none     &none         &kp KP_N0 &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_PLUS      &kp KP_EQUAL
                                                 &tog 3    &none     &tog 2        &kp RET   &kp KP_DOT &kp KP_COMMA
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none  &none  &none  &none  &none
                &none       &none         &none         &none         &none         &none               &none  &none  &none  &none  &none  &none
                &none       &studio_unlock &none        &none         &none         &none               &none  &none  &none  &none  &none  &none
                                           &none         &none         &none                            &none  &none  &none
            >;
        };

        extra_1 { status = "reserved"; };
        extra_2 { status = "reserved"; };
        extra_3 { status = "reserved"; };
    };
};
